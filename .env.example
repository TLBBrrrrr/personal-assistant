# === 模型 Provider ===
# test    = PydanticAI 内置 TestModel，离线跑通循环（无需 API key）
# litellm = 经 LiteLLM 接任意 OpenAI 兼容模型
ASSISTANT_PROVIDER=test

# 模型名（OpenAI 兼容端点用纯名，不加厂商前缀；用 probe 脚本列可用模型）
#   已验证：hy4-flash（腾讯混元旗舰，支持工具调用）
#   其它可用：hy4 / kimi-k3.1-pro / glm-5.3 / deepseek-v4-pro-0813
ASSISTANT_MODEL=hy4-flash

# API Base（OpenAI 兼容端点，结尾带 /v1）
#   已验证：https://tokenhub.tencentmaas.com/v1  （注意是 tencentmaas，不是 tencentcloudmaas）
#   该端点 /models 可列出 137 个模型；需 Bearer 鉴权的 sk- 密钥
ASSISTANT_API_BASE=

# API Key（运行时环境变量注入优先；本地写入 .env，切勿提交）
ASSISTANT_API_KEY=

# === 对话循环 ===
ASSISTANT_HOOK_ENABLED=true
ASSISTANT_HISTORY_LIMIT=0

# === 记录系统：客观指标库（与主观事件库分库） ===
ASSISTANT_METRICS_DB=metrics.db

# Garmin Connect Personal API Key 文件（同步脚本 scripts/sync_garmin.py 使用）
# 文件里只有一行裸 key（GCDC_ 开头，从 Garmin Connect 网页创建），切勿提交
# 中国区 key 只能用 personal.connectapi.garmin.cn；默认路径 .env_garmin 已在 .gitignore 忽略
GARMIN_API_KEY_FILE=.env_garmin
